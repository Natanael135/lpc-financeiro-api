MONGODB_URI=mongodb://localhost:27017/coxinha
PORT=3000

# Google Drive (fotos) — projeto GCP "lpc-fotos", cliente OAuth "LPC API (Drive)".
# GOOGLE_REFRESH_TOKEN é gerado por: node scripts/google-auth.js
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REFRESH_TOKEN=<refresh-token>
# Opcional: ID fixo da pasta raiz (senão usa/cria "LPC - Fotos" no Drive)
# GOOGLE_DRIVE_ROOT_ID=

# Chave para disparo manual de notificações (POST /notifications/run|test?key=...)
NOTIFY_SECRET=<uma-senha-qualquer>

